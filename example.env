# APNS configuration (token-based authentication)
APNS_PROD_ENVIRONMENT=false
# Host path to the APNs signing key (.p8) downloaded from the Apple Developer portal
APNS_KEY_PATH=/key/artemis-apns.p8
APNS_TEAM_ID=<apple_team_id>
APNS_KEY_ID=<apns_key_id>

# Firebase configuration
GOOGLE_APPLICATION_CREDENTIALS_JSON=/firebase.json
